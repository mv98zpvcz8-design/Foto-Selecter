# Adobe Developer Console credentials (console.adobe.io) for the
# "Lightroom Services" OAuth Web App integration. This file documents the
# required variables with no real values — copy it to .env.local (already
# gitignored) and fill in the real ones there. Never commit real secrets.

ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Adobe Developer
# Console for this integration (including https:// — Adobe requires TLS
# even for localhost).
ADOBE_REDIRECT_URI=https://localhost:5173/api/auth/callback

# Long random string used to encrypt the session cookie (access/refresh
# tokens are never stored or transmitted unencrypted). Generate e.g. with:
#   openssl rand -base64 32
SESSION_SECRET=

# Adobe Developer Console credentials for the "Photoshop API" (Firefly
# Services) product, credential type "OAuth Server-to-Server" — a separate
# credential from the Lightroom one above (client_credentials grant, no
# end-user login). Used by the opt-in "Generate with Adobe" poster flow.
ADOBE_PS_CLIENT_ID=
ADOBE_PS_CLIENT_SECRET=
# The scopes string Adobe Developer Console generates for this credential —
# copy it verbatim from the credential's page.
ADOBE_PS_SCOPES=

# Auto-populated by Vercel when a Blob store is created and linked to this
# project (Storage tab in the Vercel dashboard) — no manual value needed
# once linked, this line just documents that the variable must exist.
# Used to temporarily stage a selected photo at a public URL so the
# Photoshop API can fetch it (photos are deleted after the job completes).
BLOB_READ_WRITE_TOKEN=
