# Adobe Developer Console credentials (console.adobe.io) for the
# "Lightroom Services" OAuth Web App integration. This file documents the
# required variables with no real values — copy it to .env.local (already
# gitignored) and fill in the real ones there. Never commit real secrets.

ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Adobe Developer
# Console for this integration (including https:// — Adobe requires TLS
# even for localhost).
ADOBE_REDIRECT_URI=https://localhost:5173/api/auth/callback

# Long random string used to encrypt the session cookie (access/refresh
# tokens are never stored or transmitted unencrypted). Generate e.g. with:
#   openssl rand -base64 32
SESSION_SECRET=

# Canva Developer Portal credentials (canva.com/developers) for a Canva
# Connect API "Integration" — used by the opt-in "Design as a poster in
# Canva" flow. Unlike the old Canva Button (sunset Dec 2025), Connect APIs
# are a confidential-client OAuth flow (authorization_code + PKCE) and need
# a real client secret, so this stays server-side just like the Lightroom
# credentials above — never exposed to the browser.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must exactly match a redirect URI registered for this Integration in the
# Canva Developer Portal. Unlike Adobe, Canva rejects "localhost" outright
# for local testing — it requires the literal IP "127.0.0.1" instead.
CANVA_REDIRECT_URI=https://127.0.0.1:5173/api/canva/auth/callback
